# Copy this file to .env.local and fill in real values.
# Restart `npm run dev` after editing.

# ─── Required for Google sign-in (comments) ────────────────────
# Generate AUTH_SECRET with:  openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (from console.cloud.google.com)
# Authorized redirect URI must include:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set to "1" once the three vars above are filled.
# Client components read this to decide whether to attempt useSession().
# Without it, the site runs in "auth disabled" mode and shows a banner.
NEXT_PUBLIC_AUTH_CONFIGURED=

# ─── Required for posting comments to GitHub Discussions ──────
# Fine-grained PAT, repo-scoped, Discussions: read+write
GITHUB_TOKEN=
GITHUB_REPO_OWNER=corrtan
GITHUB_REPO_NAME=cracking-claude-certified-architect
GITHUB_DISCUSSION_CATEGORY=Question Comments

# ─── Required for cross-device lesson progress (/learn track) ──
# Set up at https://supabase.com — see SUPABASE_SETUP.md for the SQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
